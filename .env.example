# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (สำหรับรันบนเครื่องตัวเอง)
# บน Railway ให้ตั้งค่าเหล่านี้ในหน้า Variables แทน

# โทเคนบอท ได้จาก @BotFather (จำเป็น)
BOT_TOKEN=

# ช่วงเวลาที่ถือว่าซ้ำ หน่วยเป็นนาที (ค่าเริ่มต้น 1440 = 24 ชั่วโมง)
DUP_WINDOW_MINUTES=1440

# ข้อความสั้นกว่านี้ไม่ตรวจ (ค่าเริ่มต้น 3 ตัวอักษร)
MIN_LENGTH=3
