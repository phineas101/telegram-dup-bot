# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (สำหรับรันบนเครื่องตัวเอง)
# บน Railway ให้ตั้งค่าเหล่านี้ในหน้า Variables แทน

# โทเคนบอท ได้จาก @BotFather (จำเป็น)
BOT_TOKEN=

# ช่วงเวลาที่ถือว่าซ้ำ หน่วยเป็นนาที (ค่าเริ่มต้น 1440 = 24 ชั่วโมง)
DUP_WINDOW_MINUTES=1440

# ข้อความสั้นกว่านี้ไม่ตรวจ (ค่าเริ่มต้น 3 ตัวอักษร)
MIN_LENGTH=3

# ========== ตรวจข้อความซ้ำ "ข้ามกลุ่ม" (crossgroup.py) ==========
# เปิด/ปิดฟีเจอร์ (ค่าเริ่มต้นเปิด)
CROSS_GROUP_ENABLED=on
# กรอบเวลาที่ถือว่าซ้ำข้ามกลุ่ม (นาที) — ค่าเริ่มต้น 1440 = 24 ชม.
CROSS_WINDOW_MINUTES=1440
# ---- กัน "เตือนมั่ว" (false positive) ----
# ความยาวขั้นต่ำ (ตัวอักษร) ข้อความสั้นกว่านี้ไม่ตรวจข้ามกลุ่ม
CROSS_MIN_LENGTH=10
# ต้องมี "ตัวเลข" (ยอดเงิน) ถึงจะตรวจ — กันข้อความทักทาย/ประกาศที่ไม่มีเลข (แนะนำเปิด)
CROSS_REQUIRE_DIGITS=on
CROSS_MIN_DIGITS=2
# ข้อความที่มีคำเหล่านี้จะ "ข้าม" ไม่เตือน (คั่นด้วย , ) — ใส่ข้อความ broadcast ประจำที่โพสต์ทุกกลุ่ม
CROSS_IGNORE=
# ---- โหมดสังเกตการณ์ (แนะนำตอนเริ่ม) ----
# ตั้ง LOG_CHAT_ID เป็น id ห้อง Log ส่วนตัว แล้วปล่อยให้ CROSS_LOG_ONLY=on (ค่าเริ่มต้นถ้ามี LOG_CHAT_ID)
# บอทจะส่งเตือน "เข้าห้อง Log เงียบ ๆ" ให้ดูก่อน 1 วันว่าไม่เตือนมั่ว แล้วค่อยตั้ง CROSS_LOG_ONLY=off เปิดเตือนในกลุ่มจริง
LOG_CHAT_ID=
CROSS_LOG_ONLY=
# ตำแหน่งไฟล์ฐานข้อมูลข้ามกลุ่ม (แยกจาก DB ตรวจซ้ำในกลุ่ม) — ต่อ Volume Railway ที่ /data จะถาวร
CROSS_DB_PATH=/data/cross_bot.db
